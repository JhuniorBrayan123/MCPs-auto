# ============================================================================
# MCP Stack — Configuración de variables de entorno
#
# COPIA este archivo como `.env` en la RAÍZ DE TU PROYECTO (no dentro de
# tools/mcp-gitlab ni tools/mcp-bookstack) y rellena con TUS credenciales.
# El `.env` REAL no se versiona: está en .gitignore.
#
# Los servidores MCP locales (mcp-gitlab y mcp-bookstack) leen estas
# variables desde el `.env` de la raíz del proyecto por ruta explícita.
# ============================================================================

# ---------------------------------------------------------------------------
# MCP BookStack  (tools/mcp-bookstack)
# ---------------------------------------------------------------------------
# Token creado en: BookStack > Settings > API Tokens.
# El TOKEN_ID debe llevar TODOS sus caracteres (incluye el `0` inicial si existe).
BOOKSTACK_BASE_URL=https://tu-bookstack.example.com
BOOKSTACK_TOKEN_ID=tu_token_id_con_todos_sus_caracteres
BOOKSTACK_TOKEN_SECRET=tu_token_secret

# ---------------------------------------------------------------------------
# MCP GitLab  (tools/mcp-gitlab)
# ---------------------------------------------------------------------------
# Token creado en: GitLab > Settings > Access Tokens.
#  - scope `read_api`  → solo operaciones de lectura
#  - scope `api`       → lectura + escritura (crear/aprobar MRs)
GITLAB_URL=https://tu-gitlab.example.com
GITLAB_TOKEN=tu_token_personal

# ---------------------------------------------------------------------------
# MCP Excalidraw  (OPCIONAL — open-source, se instala con npx)
# ---------------------------------------------------------------------------
# Carpeta base permitida para exportar/leer escenas .excalidraw.
EXCALIDRAW_EXPORT_DIR=./docs

# ---------------------------------------------------------------------------
# MCP Jenkins  (tools/mcp-jenkins)
# ---------------------------------------------------------------------------
# API Token creado en: Jenkins > tu usuario > Configure > API Token.
JENKINS_URL=http://localhost:8080
JENKINS_USER=tu_usuario
JENKINS_TOKEN=tu_api_token
JENKINS_TIMEOUT_MS=30000
# Por defecto SOLO LECTURA: pon en "true" para permitir disparar/abortar builds.
JENKINS_ALLOW_WRITE=false
JENKINS_INSECURE_TLS=false