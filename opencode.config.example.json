
{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "bookstack": {
      "type": "local",
      "command": ["node", "tools/mcp-bookstack/dist/index.js"]
    },
    "gitlab": {
      "type": "local",
      "command": ["python", "tools/mcp-gitlab/server.py"]
    },
    "excalidraw": {
      "type": "local",
      "command": ["npx", "-y", "mcp-excalidraw-server"]
    },
    "engram": {
      "type": "local",
      "command": ["engram", "mcp", "--tools=agent"]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "elk-observability": {
      "type": "local",
      "command": ["node", "tools/launch-mcp-elk-observability.mjs"]
    },
    "jenkins": {
      "type": "local",
      "command": ["node", "tools/mcp-jenkins/dist/index.js"]
    }
  }
}