# Elasticsearch / Elastic Cloud connection
ELASTICSEARCH_URL=https://your-deployment.es.region.cloud.es.io:443
ELASTICSEARCH_API_KEY=

# Index / data stream names (override only if your deployment differs)
APM_TRACE_INDEX=traces-apm-default
APM_ERROR_INDEX=logs-apm.error-default

# Optional: comma-separated extra field paths to redact in sanitizeDocument()
# beyond the built-in defaults (Authorization, Cookie, Set-Cookie, request/response bodies)
EXTRA_SENSITIVE_FIELDS=

# Optional: enables raw error detail (still never includes API keys/secrets)
DEBUG=false

# --- Transporte MCP ---
# "stdio" (default) no requiere nada de lo que sigue: uso local, sin red, sin auth.
# "streamable-http" expone /mcp en red y requiere el proxy OAuth compartido
# (ver MCP_OAUTH_ISSUER_URL más abajo y mcp-cognito-avp).
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8014
# URL pública completa del endpoint MCP, incluyendo el path -- el ALB de
# mcp.gutierrezautomotriz.com enruta /elk-observability/* a este proceso
# (puerto 8014) vía su propio target group, junto a los otros 3 MCPs y a
# mcp-engineering-starter en la raíz. El path se usa tal cual, sin reescribir:
# src/transport/http.ts monta /mcp exactamente en este mismo path (ver ese
# archivo), así que este valor DEBE coincidir con la regla del ALB.
MCP_PUBLIC_URL=https://mcp.gutierrezautomotriz.com/elk-observability/mcp

# --- Trusted-issuer mode: este server NO habla con Cognito directo ---
# Este server es un resource server puro: el login (DCR + PKCE + Cognito
# Hosted UI) lo maneja el proxy compartido en la raíz del dominio
# (../../../mcp-oauth-proxy), y este server solo verifica los JWT que ese
# proxy firma, contra su JWKS público. No hace falta ningún campo COGNITO_*
# acá -- este server nunca contacta Cognito.
MCP_OAUTH_ISSUER_URL=https://mcp.gutierrezautomotriz.com

# --- AWS Verified Permissions (opcional; requiere MCP_OAUTH_ISSUER_URL de arriba) ---
# Policy store propio de este MCP (ver deploy/avp/elk/) -- el namespace debe
# coincidir exactamente con el de deploy/avp/elk/schema.json.
AVP_POLICY_STORE_ID=
AVP_REGION=us-east-1
AVP_CEDAR_NAMESPACE=McpELK
