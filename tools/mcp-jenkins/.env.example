# Copia estas variables al .env de la RAÍZ del proyecto (no en esta carpeta).

# URL base de Jenkins (sin barra final), p.ej. https://jenkins.miempresa.com
JENKINS_URL=http://localhost:8080

# Usuario y API Token (Jenkins > tu usuario > Configure > API Token).
# NUNCA uses tu password real: siempre un API Token revocable.
JENKINS_USER=tu_usuario
JENKINS_TOKEN=tu_api_token

# Timeout de las peticiones HTTP en milisegundos (default 30000)
JENKINS_TIMEOUT_MS=30000

# Por defecto el MCP es de SOLO LECTURA: jenkins_trigger_build y
# jenkins_stop_build devuelven error a menos que actives esto explícitamente.
JENKINS_ALLOW_WRITE=false

# Si Jenkins usa un certificado autofirmado y NO puedes agregarlo a la cadena
# de confianza del sistema, puedes desactivar la validación TLS (inseguro,
# solo para labs/dev). Nunca lo actives contra un Jenkins expuesto a internet.
JENKINS_INSECURE_TLS=false
