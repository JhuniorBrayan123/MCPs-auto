# Configuración de mcp-bookstack. Copiar como `.env` en esta misma carpeta
# (junto a `package.json`) -- el server es autocontenido, no depende de
# ningún `.env` fuera de esta carpeta (src/index.ts lo carga por ruta
# explícita, sin depender del cwd).

# --- Credenciales BookStack ---
# Token creado en: BookStack > Settings > API Tokens.
# El TOKEN_ID debe llevar TODOS sus caracteres (incluye el `0` inicial si existe).
BOOKSTACK_BASE_URL=https://tu-bookstack.com
BOOKSTACK_TOKEN_ID=tu_token_id
BOOKSTACK_TOKEN_SECRET=tu_token_secret

# ---------------------------------------------------------------------------
# Transporte MCP. "stdio" (default) no requiere nada de lo que sigue.
# "streamable-http" expone /mcp en red y requiere el proxy OAuth compartido
# (ver MCP_OAUTH_ISSUER_URL más abajo y mcp-cognito-avp).
# ---------------------------------------------------------------------------
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8011
# El ALB de mcp.gutierrezautomotriz.com enruta /bookstack/* a este proceso
# (puerto 8011) vía su propio target group, junto a los otros 3 MCPs y a
# mcp-oauth-proxy en la raíz. El path se usa tal cual, sin reescribir:
# src/transport/http.ts monta /mcp exactamente en este mismo path (ver ese
# archivo), así que este valor DEBE coincidir con la regla del ALB.
MCP_PUBLIC_URL=https://mcp.gutierrezautomotriz.com/bookstack/mcp

# --- Trusted-issuer mode: este server NO habla con Cognito directo ---
# Este server es un resource server puro: el login (DCR + PKCE + Cognito
# Hosted UI) lo maneja el proxy compartido en la raíz del dominio
# (../../../mcp-oauth-proxy), y este server solo verifica los JWT que ese
# proxy firma, contra su JWKS público. No hace falta ningún campo COGNITO_*
# acá -- este server nunca contacta Cognito.
MCP_OAUTH_ISSUER_URL=https://mcp.gutierrezautomotriz.com

# --- AWS Verified Permissions (opcional; requiere MCP_OAUTH_ISSUER_URL de arriba) ---
# Policy store propio de este MCP (ver ../../deploy/avp/bookstack/). Dejar
# vacío para arrancar sin gate por tool (todo caller autenticado ve todas
# las tools) mientras no exista el policy store todavía.
AVP_POLICY_STORE_ID=
AVP_REGION=us-east-1
AVP_CEDAR_NAMESPACE=McpBookstack
