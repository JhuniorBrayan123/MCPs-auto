# Credenciales para el MCP BookStack.
# SOLO documentación — este archivo no se usa en runtime. El server lee
# BOOKSTACK_* desde el `.env` de la RAÍZ del proyecto como ÚNICA fuente
# de credenciales (ruta explícita en src/index.ts); ese `.env` raíz no
# se versiona.
BOOKSTACK_BASE_URL=https://tu-bookstack.com
BOOKSTACK_TOKEN_ID=tu_token_id
BOOKSTACK_TOKEN_SECRET=tu_token_secret
