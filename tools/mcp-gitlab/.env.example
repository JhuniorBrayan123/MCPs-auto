# Configuración de mcp-gitlab. Copiar como `.env` en esta misma carpeta
# (junto a `server.py`) -- el server es autocontenido, no depende de
# ningún `.env` fuera de esta carpeta (server.py lo carga por ruta
# explícita, sin depender del cwd).

# --- Credenciales GitLab ---
# Token creado en: GitLab > Settings > Access Tokens.
#  - scope `read_api`  → solo operaciones de lectura
#  - scope `api`       → lectura + escritura (crear/aprobar MRs)
GITLAB_URL=https://gitlab.sreasons.com
GITLAB_TOKEN=tu_token_personal

# ---------------------------------------------------------------------------
# Transporte MCP. "stdio" (default) no requiere nada de lo que sigue: uso
# local, sin red, sin auth. "streamable-http" expone /mcp en red y requiere
# el proxy OAuth compartido (ver MCP_OAUTH_ISSUER_URL más abajo y mcp-cognito-avp).
# ---------------------------------------------------------------------------
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8013
# El ALB de mcp.gutierrezautomotriz.com enruta /gitlab/* a este proceso
# (puerto 8013) vía su propio target group, junto a los otros 3 MCPs y a
# mcp-oauth-proxy en la raíz. El path se usa tal cual, sin reescribir:
# server.py pasa streamable_http_path derivado de esta misma URL (ver el
# bloque `if __name__ == "__main__"`), así que este valor DEBE coincidir
# con la regla del ALB.
MCP_PUBLIC_URL=https://mcp.gutierrezautomotriz.com/gitlab/mcp

# --- Trusted-issuer mode: este server NO habla con Cognito directo ---
# Este server es un resource server puro: el login (DCR + PKCE + Cognito
# Hosted UI) lo maneja el proxy compartido en la raíz del dominio
# (../../../mcp-oauth-proxy), y este server solo verifica los JWT que ese
# proxy firma, contra su JWKS público. No hace falta ningún campo COGNITO_*
# acá -- este server nunca contacta Cognito.
MCP_OAUTH_ISSUER_URL=https://mcp.gutierrezautomotriz.com

# --- AWS Verified Permissions (opcional; requiere MCP_OAUTH_ISSUER_URL de arriba) ---
# Policy store propio de este MCP (ver ../../deploy/avp/gitlab/). Dejar
# vacío para arrancar sin gate por tool (todo caller autenticado ve todas
# las tools) mientras no exista el policy store todavía.
AVP_POLICY_STORE_ID=
AVP_REGION=us-east-1
AVP_CEDAR_NAMESPACE=McpGitlab
