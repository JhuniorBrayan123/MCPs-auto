# Credenciales para el MCP GitLab.
# SOLO documentación — este archivo no se usa en runtime. El server lee
# GITLAB_URL y GITLAB_TOKEN desde el `.env` de la RAÍZ del proyecto como
# ÚNICA fuente de credenciales (ruta explícita vía parents[2]); ese `.env`
# raíz no se versiona.
GITLAB_URL=https://gitlab.sreasons.com
GITLAB_TOKEN=tu_token_personal
